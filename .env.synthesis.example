# Optional paths for ``scripts/connectors/build_connector_manifests.py --synthesize`` (defaults: sibling repos).
# Primary connector catalog: OpenConnector (run ``npm run generate:catalog`` there first).
# BASIS_SYNTHESIS_OPEN_CONNECTOR_ROOT=/path/to/open-connector
# Fallback legacy export: basis connectors catalog apps
# BASIS_SYNTHESIS_ANYCONNECT_CATALOG=/path/to/basis/connectors/catalog/apps
# BASIS_SYNTHESIS_PROVIDERS_REGISTRY=/path/to/packages/providers/providers.yaml
# BASIS_SYNTHESIS_AIRBYTE_ROOT=/path/to/airbyte/airbyte-integrations/connectors
# BASIS_SYNTHESIS_EXECUTOR_INDEX=/path/to/custom-executors-index.json
