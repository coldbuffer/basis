# Vite desktop mode (ADR 0004). API port is OS-assigned (profile port 0).
# Electron sets VITE_BASIS_API_URL on the renderer. Standalone Vite: proxy via BASIS_API_URL
# (same as cloud dev), or set VITE_BASIS_API_URL for direct API calls:
#   BASIS_API_URL=http://127.0.0.1:<port> npm run dev:desktop
# Renderer: http://127.0.0.1:3002 (see web package.json dev:desktop)
VITE_BASIS_AUTH_REQUIRED=false
VITE_BASIS_DESKTOP=true
