{
  "name": "@basis/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types server/dev.ts",
    "dev:vite": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "vite --mode desktop --host 127.0.0.1 --port 3001 --strictPort",
    "dev:desktop:electron": "npm run dev --prefix ../desktop",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "build:desktop": "tsc --noEmit && vite build --mode desktop",
    "start": "node --experimental-strip-types server/prod.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "audit:locale": "npx tsx scripts/audit-locale-usage.mjs",
    "test": "vitest run",
    "test:e2e": "npm run test --prefix ../tests/e2e",
    "test:e2e:ui": "npm run test:ui --prefix ../tests/e2e",
    "test:workspace-ws-client": "node src/lib/workspace/ws-client.test.mjs",
    "gen:openapi-types": "openapi-typescript ../openapi/basis-v1.json -o src/lib/openapi/schema.d.ts && openapi-typescript ../openapi/basis-v1-workspaces.json -o src/lib/openapi/schema-workspaces.d.ts",
    "gen:product-docs-mdx": "node scripts/generate-product-docs-mdx.mjs",
    "gen:mcp-tools-docs": "cd .. && uv run python scripts/docs/generate-product-docs-mcp-tools.py",
    "postinstall": "fumadocs-mdx",
    "preview": "vite preview",
    "clean": "rm -rf ../dist/web"
  },
  "dependencies": {
